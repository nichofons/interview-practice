class Solution:
    def targetIndices(self, nums: list[int], target: int) -> list[int]:
        buckets = {k:0 for k in range(1,101)}
        index = 0
        for num in nums:
            buckets[num] += 1
        for num in range(1,101):
            if num == target:
                return [i for i in range(index, index + buckets[num])]
            index += buckets[num]
